{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/ci/check-budget.mjs",
    "check:secrets": "node scripts/ci/check-secrets.mjs",
    "registry:build": "tsx scripts/registry/build-registry.ts --strict",
    "registry:check": "npm run registry:build && git diff --exit-code -- src/data/generated",
    "registry:wikidata": "tsx scripts/registry/enrich-wikidata.ts",
    "api:build": "node scripts/build-api.mjs",
    "api:check": "npm run api:build && git diff --exit-code -- api"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@microsoft/clarity": "^1.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "flubber": "^0.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.37.0",
    "pixi.js": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-joyride": "^2.9.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@turf/turf": "^7.3.4",
    "@types/express": "^4.17.21",
    "@types/flubber": "^0.4.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^3.2.7"
  }
